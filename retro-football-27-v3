function teamAverageOVR(teamIndex){
  let scope=matchTeams(), names=(career.competition==='Mundial'||career.competition==='Best of The Best')?scope[teamIndex].players:(lineupForTeam(teamIndex).map(p=>p.name));
  let vals=names.slice(0,11).map((n,i)=>playerData(n,scope[teamIndex].name,teamIndex,i).ovr);
  return vals.reduce((a,b)=>a+b,0)/(vals.length||1);
}

function simulatedGoals(avgA,avgB){
  let diff=avgA-avgB;
  let baseA=1.15+diff*.045,baseB=1.15-diff*.045;
  let poisson=lambda=>{let L=Math.max(.15,Math.min(3.8,lambda)),L0=Math.exp(-L),p=1,k=0;while(p>L0&&k<8){p*=Math.random();k++}return k-1};
