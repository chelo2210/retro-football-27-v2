.fifaPitch::after{
  content:"";position:absolute;left:50%;top:8%;bottom:8%;width:2px;margin-left:-1px;background:rgba(255,255,255,.28);pointer-events:none
}
.fifaCenter{
  position:absolute;left:50%;top:50%;width:18%;aspect-ratio:1;margin:-9% 0 0 -9%;
  border:2px solid rgba(255,255,255,.28);border-radius:50%;pointer-events:none
}
.fifaBoxT,.fifaBoxB{
