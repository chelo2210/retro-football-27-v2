}
function nextWorldCupFixture(){
  if(!career||career.competition!=='Mundial')return;
  if(career.phase==='groups'){
    let g=career.table[career.team]?.grp;if(g==null||g<0){career.opp=career.team;return}
    let members=career.wcGroups[g]||[];
    let others=members.filter(i=>i!==career.team);
    /* 3 group games against the other 3 */
    if(career.leagueRound>=others.length){advanceWorldCupFromGroups();return}
    career.opp=others[career.leagueRound];
  }else if(career.phase==='knockout'&&career.knockout){
    let rnd=career.knockout.rounds[career.knockout.round];
    let pair=rnd?.find(p=>p[0]===career.team||p[1]===career.team);
    career.opp=pair?(pair[0]===career.team?pair[1]:pair[0]):career.team;
  }
}
function advanceWorldCupFromGroups(){
  /* top 2 from each group → R16 */
  let qual=[];
  for(let g=0;g<8;g++){
    let mem=(career.wcGroups[g]||[]).map(i=>career.table[i]).filter(Boolean).sort((a,b)=>b.pts-a.pts||(b.gf-b.ga)-(a.gf-a.ga)||b.gf-a.gf);
    if(mem[0])qual.push(mem[0].i);if(mem[1])qual.push(mem[1].i);
  }
  if(!qual.includes(career.team)){career.results.push('❌ Eliminado en fase de grupos');career.phase='done';career.leagueFinished=true;return}
  /* bracket: pair 1v2 style */
  let pairs=[];
  for(let i=0;i<qual.length;i+=2)pairs.push([qual[i],qual[i+1]??qual[0]]);
  career.knockout={rounds:[pairs],round:0,stage:'R16'};
  career.phase='knockout';career.leagueRound=0;
  career.results.push('🏅 Clasificado a octavos de final');
  nextWorldCupFixture();
}
function advanceKnockout(won){
  if(!career.knockout)return;
  let stage=career.knockout.stage||'R16';
  if(!won){career.results.push('❌ Eliminado en '+stage);career.phase='done';career.leagueFinished=true;return}
  let rnd=career.knockout.rounds[career.knockout.round];
  let winners=[];
  /* simulate other ties, keep player if won */
  for(let pair of (rnd||[])){
    if(pair[0]===career.team||pair[1]===career.team){winners.push(career.team);continue}
    let a=pair[0],b=pair[1],oa=80,ob=80;try{oa=teamAverageOVR(a);ob=teamAverageOVR(b)}catch(e){}
    winners.push((oa+Math.random()*5)>=(ob+Math.random()*5)?a:b);
  }
  if(winners.length<=1){career.results.push('🏆 CAMPEÓN · '+matchTeams()[career.team].name);career.phase='done';career.leagueFinished=true;career.leagueChampion=career.team;return}
  let nextPairs=[];
  for(let i=0;i<winners.length;i+=2)nextPairs.push([winners[i],winners[i+1]??winners[0]]);
  let stages={R16:'QF',QF:'SF',SF:'Final',Final:'Champion'};
  career.knockout.round++;
  career.knockout.rounds.push(nextPairs);
  career.knockout.stage=stages[stage]||'Final';
  career.results.push('➡️ Avanza a '+career.knockout.stage);
  nextWorldCupFixture();
}
