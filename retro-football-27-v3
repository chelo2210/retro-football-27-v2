}

function simulateMatch(){
  if(!career)return;
  let a=teamAverageOVR(career.team),b=teamAverageOVR(career.opp),[ga,gb]=simulatedGoals(a,b);
  if(career.competition==='Mundial'){
    career.results.push(`🎲 SIMULADO · ${matchTeams()[career.team].name} ${ga}-${gb} ${matchTeams()[career.opp].name} · OVR ${a.toFixed(1)} vs ${b.toFixed(1)}`);
