function simulateLeagueRivals(){
  if(!career||career.competition!=='Liga')return;
  let round=career.leagueSchedule?.[career.leagueRound]||[];
  for(let pair of round){
    let a=pair[0],b=pair[1],oa=teamAverageOVR(a),ob=teamAverageOVR(b),[ga,gb]=simulatedGoals(oa,ob),ta=career.table.find(x=>x.i===a),tb=career.table.find(x=>x.i===b);
    if(!ta||!tb)continue;
    ta.p++;tb.p++;ta.gf+=ga;ta.ga+=gb;tb.gf+=gb;tb.ga+=ga;
    if(ga>gb){ta.w++;ta.pts+=3;tb.l++}else if(gb>ga){tb.w++;tb.pts+=3;ta.l++}else{ta.d++;tb.d++;ta.pts++;tb.pts++}
  }
}

function advanceManagerLeague(){
  if(career.competition!=='Liga'||gameMode!=='manager')return;
  // Se simulan únicamente los partidos de los otros equipos de ESTA jornada.
  // Tú ya acabas de jugar contra el rival de esta misma jornada.
  simulateLeagueRivals();
  career.leagueRound++;
  career.week=career.leagueRound+1;
  if(career.leagueRound>=career.leagueOpponents.length){
    let rows=standings();
    career.leagueFinished=true;
    career.leagueChampion=rows[0]?.i??career.team;
    career.results.push(`🏆 CAMPEÓN DE LIGA · ${teamName(career.leagueChampion)} · ${rows[0]?.pts??0} PTS`);
    career.opp=career.team;
  }else{
    career.opp=career.leagueOpponents[career.leagueRound]??career.leagueOpponents[career.leagueOpponents.length-1];
  }
}

function advanceDefinitive(won){
  let br=career.definitiveBracket;if(!br)return;
  if(!won){career.results.push('❌ Eliminado en '+definitiveStageLabel(br.stage));career.phase='done';br.champion=null;return}
  let rnd=br.rounds[br.round]||[],winners=[];
  for(let pair of rnd){
    if(pair.includes(career.team)){winners.push(career.team);continue}
    let oa=teamAverageOVR(pair[0]),ob=teamAverageOVR(pair[1]);winners.push((oa+Math.random()*6)>=(ob+Math.random()*6)?pair[0]:pair[1]);
  }
  if(winners.length===1){br.champion=winners[0];br.stage='Champion';career.phase='done';career.leagueFinished=true;career.leagueChampion=winners[0];career.results.push('🏆 CAMPEÓN · '+matchTeams()[winners[0]].name);return}
