    if(career.phase==='groups'){career.leagueRound++;career.week++;nextWorldCupFixture()}
    else if(career.phase==='knockout'){let won=G.score[0]>G.score[1]||(G.score[0]===G.score[1]&&G.penaltyWinner===0);advanceKnockout(won)}
    else career.week++;
  }else career.week++;
