function buildLeagueSchedule(){
  if(!career||career.competition!=='Liga')return;
  let me=career.team??0,others=TEAMS.map((_,i)=>i).filter(i=>i!==me),pool=others.slice(),bye=null;
  // 49 rivales: sistema de todos-contra-todos entre ellos, con un descanso por jornada.
  pool.push(null); // 50 posiciones para generar 49 jornadas exactas.
  let rounds=[];
  for(let r=0;r<pool.length-1;r++){
    let pairs=[];
    for(let i=0;i<pool.length/2;i++){
      let a=pool[i],b=pool[pool.length-1-i];
      if(a!=null&&b!=null)pairs.push([a,b]);
    }
    rounds.push(pairs);
    let fixed=pool[0],rest=pool.slice(1),last=rest.pop();pool=[fixed,last,...rest];
  }
  career.leagueSchedule=rounds;
  // Randomize the order of your 49 league rivals every new Manager season.
  for(let i=others.length-1;i>0;i--){let j=(Math.random()*(i+1))|0;[others[i],others[j]]=[others[j],others[i]]}
  career.leagueOpponents=others;
  career.opp=others[career.leagueRound??0]??me;
  career.scheduleVersion=2;
}
