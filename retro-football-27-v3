function finishMatch(){
  if(!career||!G)return;
  let a=G.score[0],b=G.score[1];
  if(G.penaltyWinner!=null&&G.penalties&&(G.penalties.score[0]||G.penalties.score[1])){a=G.penalties.score[0];b=G.penalties.score[1]}
  let r=a>b?'V':a<b?'D':'E';
  let scope=matchTeams();
  let tName=(scope[career.team]?.name)||(scope[career.team]?.[0])||'YO';
  let oName=(scope[career.opp]?.name)||(scope[career.opp]?.[0])||'RIVAL';
  if(career.competition==='Best of The Best'&&gameMode==='definitive'){
    let won=a>b||(a===b&&G.penaltyWinner===0);
    career.results.push(`${won?'🟢':'🔴'} ${tName} ${G.score[0]}-${G.score[1]} ${oName}`);
    advanceDefinitive(won);
    save();
    return;
  }
  let t=career.table.find(x=>x.i===career.team),o=career.table.find(x=>x.i===career.opp);
  if(t&&o){t.gf+=G.score[0];t.ga+=G.score[1];o.gf+=G.score[1];o.ga+=G.score[0];t.p=(t.p||0)+1;o.p=(o.p||0)+1;if(G.score[0]>G.score[1]){t.w++;t.pts+=3;o.l++}else if(G.score[0]<G.score[1]){o.w++;o.pts+=3;t.l++}else{t.d++;o.d++;t.pts++;o.pts++}}
  career.results.push(`${r==='V'?'🟢':r==='E'?'🟡':'🔴'} ${tName} ${G.score[0]}-${G.score[1]} ${oName}`);
  career.budget+=(G.score[0]>G.score[1]?4.5:1.5);
  if(career.competition==='Liga'&&gameMode==='manager')advanceManagerLeague();
  else if(career.competition==='UCL'&&gameMode==='manager'){
    if(career.phase==='league'){
      career.leagueRound++;career.week++;
      if(career.leagueRound>=(career.leagueOpponents?.length||8))advanceUCLFromLeague();
      else career.opp=career.leagueOpponents[career.leagueRound];
    }else if(career.phase==='knockout'){
      let won=G.score[0]>G.score[1]||(G.score[0]===G.score[1]&&G.penaltyWinner===0);
