.modeCard h2{font-size:18px;margin:6px 0 6px}
.modeCard p{margin:0;color:var(--muted);font-size:13px;font-weight:500}
.modeIcon{font-size:32px;line-height:1}
.mainMenuTop{display:flex;align-items:center;justify-content:flex-end;margin:4px 0 2px;position:relative}
